# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Chat model backend: "mistral" (hosted, EU) or "ollama" (local)
LLM_PROVIDER=mistral

MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ministral-3:8b

# Embeddings always run locally via Ollama
EMBEDDING_MODEL=bge-m3

# Postgres + pgvector
DATABASE_URL=postgresql://energy:energy@localhost:5432/energy_agent
